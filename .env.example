# ─────────────────────────────────────────────────────────────────────────────
# Library Agent - Variables de entorno
# Copia este archivo a .env y rellena los valores reales.
# NUNCA comitas .env al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ── WhatsApp Cloud API (Meta for Developers) ──────────────────────────────────
# Token de verificación del webhook: elige una cadena secreta arbitraria
VERIFY_TOKEN=mi_token_secreto

# Access Token de WhatsApp (temporal de 24 h en desarrollo, permanente en prod)
WHATSAPP_ACCESS_TOKEN=

# ID del número de teléfono de la cuenta de WhatsApp Business
PHONE_NUMBER_ID=

# ID de la cuenta de WhatsApp Business (WABA) — solo necesario para consultar suscripciones
WABA_TOKEN_ID=

# ── Llama Stack ───────────────────────────────────────────────────────────────
# URL donde corre el servidor de Llama Stack (por defecto local)
LLAMA_STACK_URL=http://localhost:8321

# Timeout en segundos para las llamadas al LLM (aumentar si el hardware es lento)
LLAMA_STACK_TIMEOUT=300

# Nombre del modelo registrado en Llama Stack
LLAMA_MODEL=ollama/llama3.1:8b

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434

# Modelo de Llama Guard registrado en Ollama
LLAMA_GUARD_MODEL=llama-guard3

# ── Hugging Face (Prompt Guard — opcional) ───────────────────────────────────
# Requiere aceptar la licencia de meta-llama/Llama-Prompt-Guard-2-86M en HF
HF_TOKEN=

# ── Embeddings (RAG) ──────────────────────────────────────────────────────────
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RAG_THRESHOLD=0.30

# ── Servidor ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ── Modo de pruebas (sin servicios externos) ──────────────────────────────────
# Cambia a true para ejecutar sin Ollama, Llama Stack ni WhatsApp API
TEST_MODE=false
